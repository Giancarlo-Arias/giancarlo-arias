---
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import "../styles/global.css";
import { getMessages } from "../i18n";
import type { Locale, PageId } from "../i18n/types";

interface Props {
  page: PageId;
}

const { page } = Astro.props as Props;
const locale = (Astro.currentLocale ?? "es") as Locale;
const messages = getMessages(locale);
const pageContent = messages[page];
const pageTitle = `${pageContent.title} | ${messages.site.name}`;
const pageDescription = pageContent.description;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const currentPath = Astro.url.pathname;
const deferNavbarReveal = currentPath === "/" || currentPath === "/en";
---

<!DOCTYPE html>
<html lang={locale}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
</head>
<body class="min-h-screen overflow-x-hidden bg-[var(--surface-page)] text-[var(--text-main)] antialiased">
    <Navbar currentPath={currentPath} locale={locale} page={page} deferReveal={deferNavbarReveal} />
    <main id="main-content" class="relative z-10">
      <slot />
    </main>
    <Footer locale={locale} />
</body>
</html>
