---
import { getMessages } from "../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../../i18n/types";

const locale = (Astro.currentLocale ?? "es") as Locale;
const t = getMessages(locale).contact;
const whatsappUrl = "https://wa.me/50660058595";
const homeUrl = getRelativeLocaleUrl(locale);
---

<section data-contact class="contact-surface relative overflow-hidden px-5 pb-20 pt-28 sm:px-6 lg:px-10 lg:pb-28 lg:pt-36">
  <div class="mx-auto max-w-7xl 2xl:max-w-[110rem]">
    <header data-contact-intro class="contact-header grid gap-7 pb-11 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,.75fr)] lg:items-end lg:gap-16 lg:pb-14">
      <div>
        <p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.18em] text-[var(--brand)]"><span class="h-2 w-2 rounded-full bg-[var(--brand)]"></span>{t.eyebrow}</p>
        <h1 class="max-w-[13ch] text-[clamp(2.7rem,5.2vw,5.6rem)] font-semibold leading-[.93] tracking-[-.052em] text-[var(--text-main)]">{t.heading}</h1>
      </div>
      <p class="max-w-[32rem] text-base leading-7 text-[var(--text-muted)] sm:text-lg sm:leading-8">{t.intro}</p>
    </header>

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(16rem,.68fr)_minmax(0,1.12fr)] lg:gap-16">
      <aside data-contact-brief class="contact-brief rounded-[1.65rem] p-6 sm:p-8 lg:sticky lg:top-28">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#128C7E] text-white shadow-[0_10px_24px_rgb(18_140_126_/_20%)]">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.73.45 3.42 1.3 4.9L2 22l5.44-1.42a9.82 9.82 0 0 0 4.58 1.16h.01c5.41 0 9.82-4.4 9.82-9.82A9.75 9.75 0 0 0 19.05 4.91Zm-7.02 15.18h-.01a8.1 8.1 0 0 1-4.12-1.12l-.3-.18-3.23.84.86-3.15-.2-.32a8.14 8.14 0 0 1-1.25-4.33c0-4.49 3.67-8.15 8.17-8.15 2.18 0 4.22.84 5.76 2.39a8.08 8.08 0 0 1 2.38 5.77c0 4.49-3.67 8.15-8.16 8.15Zm4.47-6.11c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.95-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.31-.22.24-.84.82-.84 2 0 1.18.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" /></svg>
        </div>
        <p class="mt-8 text-xs font-semibold uppercase tracking-[.18em] text-[var(--brand)]">{t.channelEyebrow}</p>
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="group mt-3 inline-flex items-center gap-2 text-xl font-semibold tracking-[-.035em] text-[var(--text-main)] transition-colors hover:text-[#128C7E]">
          +506 6005 8595
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <p class="mt-3 max-w-sm text-sm leading-6 text-[var(--text-muted)]">{t.channelDescription}</p>

        <dl class="mt-8 grid gap-5 border-t border-[var(--text-main)]/10 pt-6 text-sm leading-6">
          <div>
            <dt class="font-semibold text-[var(--text-main)]">{t.focusLabel}</dt>
            <dd class="mt-1 text-[var(--text-muted)]">{t.focusValue}</dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--text-main)]">{t.stackLabel}</dt>
            <dd class="mt-1 text-[var(--text-muted)]">{t.stackValue}</dd>
          </div>
        </dl>

        <a href={homeUrl} class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-main)] transition-colors hover:text-[var(--brand)]">← {t.homeCta}</a>
      </aside>

      <div data-contact-form-shell class="contact-form-shell relative overflow-hidden rounded-[1.65rem] p-6 sm:p-8 md:p-10">
        <div class="pointer-events-none absolute right-0 top-0 h-48 w-48 -translate-y-1/2 translate-x-1/3 rounded-full bg-[var(--glow-sky)] opacity-70 blur-3xl"></div>
        <div class="relative">
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-[var(--brand)]">{t.formEyebrow}</p>
          <h2 class="mt-3 text-[clamp(2rem,3.4vw,3.1rem)] font-semibold leading-[.98] tracking-[-.045em] text-[var(--text-main)]">{t.formHeading}</h2>

          <form
            data-contact-form
            data-sending-label={t.sendingLabel}
            data-success-message={t.successMessage}
            data-error-message={t.errorMessage}
            action="/api/contact"
            method="post"
            class="mt-9 grid gap-6"
            novalidate
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="contact-field">
                <span>{t.nameLabel}</span>
                <input name="name" type="text" autocomplete="name" required maxlength="80" class="contact-input" />
              </label>
              <label class="contact-field">
                <span>{t.emailLabel}</span>
                <input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" class="contact-input" />
              </label>
            </div>
            <label class="contact-field">
              <span>{t.messageLabel}</span>
              <textarea name="message" required minlength="10" maxlength="4000" rows="6" placeholder={t.messagePlaceholder} class="contact-input min-h-40 resize-y"></textarea>
            </label>
            <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
              <label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
            </div>
            <div class="flex flex-col gap-4 border-t border-[var(--text-main)]/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
              <button data-contact-submit type="submit" class="contact-submit group inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[var(--text-main)] px-5 py-3 text-sm font-semibold text-white disabled:cursor-wait disabled:opacity-70">
                <span>{t.submitLabel}</span>
                <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <p data-contact-status class="min-h-5 max-w-[22rem] text-sm leading-5 text-[var(--text-muted)] sm:text-right" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../utils/contact-animation";

  const initContactForms = () => {
    document.querySelectorAll("[data-contact-form]").forEach((form) => {
    if (form.dataset.contactReady === "true") return;
    form.dataset.contactReady = "true";
    const submit = form.querySelector("[data-contact-submit]");
    const status = form.querySelector("[data-contact-status]");
    const label = submit?.querySelector("span");
    const defaultLabel = label?.textContent ?? "";
    const sendingLabel = form.dataset.sendingLabel || "Sending…";
    const successMessage = form.dataset.successMessage || "Message sent successfully.";
    const errorMessage = form.dataset.errorMessage || "Unable to send the message.";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !submit || !status || !label) return;
      submit.disabled = true;
      label.textContent = sendingLabel;
      status.textContent = "";
      status.classList.remove("contact-status-success", "contact-status-error");

      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message);
        form.reset();
        status.textContent = result.message || successMessage;
        status.classList.add("contact-status-success");
      } catch {
        status.textContent = errorMessage;
        status.classList.add("contact-status-error");
      } finally {
        submit.disabled = false;
        label.textContent = defaultLabel;
      }
    });
    });
  };

  initContactForms();
  document.addEventListener("astro:page-load", initContactForms);
</script>

<style>
  .contact-surface {
    background:
      radial-gradient(circle at 88% 14%, color-mix(in srgb, var(--glow-sky) 76%, transparent), transparent 28%),
      radial-gradient(circle at 6% 82%, color-mix(in srgb, var(--glow-mint) 55%, transparent), transparent 27%);
  }
  .contact-header { border-bottom: 1px solid var(--line-soft); }
  .contact-brief {
    border: 1px solid rgb(22 32 47 / 9%);
    background: color-mix(in srgb, var(--surface-page) 78%, white);
    box-shadow: 0 18px 50px rgb(22 32 47 / 5%);
  }
  .contact-form-shell {
    border: 1px solid rgb(22 32 47 / 10%);
    background: color-mix(in srgb, white 84%, var(--surface-page));
    box-shadow: 0 24px 70px rgb(22 32 47 / 8%);
  }
  .contact-field { display: grid; gap: .55rem; color: var(--text-main); font-size: .875rem; font-weight: 600; line-height: 1.25rem; }
  .contact-input {
    width: 100%;
    min-height: 3.25rem;
    border: 1px solid rgb(22 32 47 / 16%);
    border-radius: .8rem;
    background: rgb(250 248 243 / 64%);
    padding: .8rem .95rem;
    color: var(--text-main);
    font: inherit;
    font-weight: 400;
    line-height: 1.5;
    outline: none;
    transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease;
  }
  textarea.contact-input { padding-top: .85rem; }
  .contact-input::placeholder { color: color-mix(in srgb, var(--text-muted) 77%, transparent); }
  .contact-input:hover { border-color: rgb(22 32 47 / 30%); }
  .contact-input:focus { border-color: var(--brand); background: white; box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 15%, transparent); }
  .contact-submit { box-shadow: 0 10px 22px rgb(22 32 47 / 13%); transition: transform .22s ease, background-color .22s ease, box-shadow .22s ease; }
  .contact-submit:hover { background: var(--brand); box-shadow: 0 14px 28px color-mix(in srgb, var(--brand) 27%, transparent); transform: translateY(-2px); }
  .contact-submit:active { transform: translateY(0) scale(.98); }
  .contact-submit:focus-visible, .contact-brief a:focus-visible { outline: 3px solid color-mix(in srgb, var(--brand) 42%, transparent); outline-offset: 4px; }
  .contact-status-success { color: #128c7e; }
  .contact-status-error { color: #b42318; }
  @media (prefers-reduced-motion: reduce) {
    .contact-input, .contact-submit, .contact-brief a svg { transition: none; }
  }
</style>
