---
import astroIcon from "@icons/astro.svg?url";
import gsapIcon from "@icons/gsap.svg?url";
import htmlIcon from "@icons/html.svg?url";
import jsIcon from "@icons/js.svg?url";
import nextjsIcon from "@icons/nextjs.svg?url";
import profileImage from "../../assets/images/profile/giancarlo.jpeg";
import reactIcon from "@icons/react.svg?url";
import seoIcon from "@icons/seo.svg?url";
import tailwindIcon from "@icons/tailwind.svg?url";
import tsIcon from "@icons/ts.svg?url";
import wordpressIcon from "@icons/wordpress.svg?url";
import fastapiIcon from "@icons/fastapi.svg?url";
import netIcon from "@icons/net.svg?url";
import postgresqlIcon from "@icons/postgresql.svg?url";
import dockerIcon from "@icons/docker.svg?url";
import pythonIcon from "@icons/python.svg?url";
import { getMessages } from "../../i18n";
import type { Locale } from "../../i18n/types";

const locale = (Astro.currentLocale ?? "es") as Locale;
const t = getMessages(locale).home;

const stackIcons = [
  { name: "Astro", icon: astroIcon },
  { name: "Tailwind CSS", icon: tailwindIcon },
  { name: "JavaScript", icon: jsIcon },
  { name: "TypeScript", icon: tsIcon },
  { name: "React", icon: reactIcon },
  { name: "FastAPI", icon: fastapiIcon },
  { name: ".NET Core", icon: netIcon },
  { name: "PostgreSQL", icon: postgresqlIcon },
  { name: "Docker", icon: dockerIcon },
  { name: "Python", icon: pythonIcon },
  { name: "Next.js", icon: nextjsIcon },
  { name: "WordPress", icon: wordpressIcon },
  { name: "HTML", icon: htmlIcon },
  { name: "GSAP", icon: gsapIcon },
  { name: "SEO", icon: seoIcon },
];
---

<div data-hero-root class="hero-surface text-[var(--text-main)]">
<div
  data-hero-loader
  class="fixed inset-0 z-50 flex min-h-screen items-center justify-center overflow-hidden bg-[var(--surface-page)]"
>
  <div class="absolute inset-0">
    <div
      data-loader-line
      class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-[var(--text-main)]/45"
    ></div>
  </div>

  <div
    class="relative grid w-full max-w-[88rem] grid-cols-[1fr_auto_1fr] items-center px-6 text-[clamp(2.4rem,8vw,7rem)] font-semibold tracking-[-0.065em] text-[var(--text-main)]"
  >
    <span data-loader-word="left" class="justify-self-end pr-5 text-right sm:pr-8">Giancarlo</span>
    <span class="w-[2px]"></span>
    <span data-loader-word="right" class="justify-self-start pl-5 text-left sm:pl-8">Arias</span>
  </div>
</div>

<section
  data-hero
  class="mx-auto grid w-full max-w-7xl items-center gap-10 overflow-x-clip px-5 pb-20 pt-28 sm:px-6 sm:pt-32 xl:grid-cols-[minmax(0,1.05fr)_minmax(0,.95fr)] xl:gap-14 xl:pt-32 xl:pb-28 2xl:max-w-[110rem] 2xl:px-10"
>
  <div class="min-w-0 space-y-6 pt-2 lg:space-y-7 lg:pt-2" data-hero-copy>
    <div class="space-y-5">
      <p data-reveal-text class="text-sm uppercase tracking-[0.25em] text-[var(--brand)]">
        {t.heroEyebrow}
      </p>

      <h1 data-reveal-text class="max-w-4xl text-5xl font-semibold leading-[0.95] tracking-[-0.065em] text-[var(--text-main)] md:text-7xl xl:text-8xl">
        {t.heroHeading}
      </h1>

      <p data-reveal-text class="max-w-2xl text-lg leading-8 text-[var(--text-muted)] md:text-xl">
        {t.heroIntro}
      </p>
    </div>

    <div class="flex flex-wrap gap-4">
      <a
        href="#about"
        class="inline-flex min-h-12 items-center gap-2.5 rounded-xl bg-[var(--text-main)] px-[1.125rem] py-3 font-medium text-[var(--surface-page)] transition-[transform,background-color] duration-300 hover:-translate-y-1 hover:bg-[var(--brand)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand)]"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M5 12h14" stroke-linecap="round" />
          <path d="m13 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{t.profileCta}</span>
      </a>

      <a
        href="https://wa.me/50660058595"
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-12 items-center gap-2.5 rounded-xl border border-[var(--text-main)]/25 px-[1.125rem] py-3 font-medium text-[var(--text-main)] transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-[var(--brand)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--brand)]"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.73.45 3.42 1.3 4.9L2 22l5.44-1.42a9.82 9.82 0 0 0 4.58 1.16h.01c5.41 0 9.82-4.4 9.82-9.82A9.75 9.75 0 0 0 19.05 4.91Zm-7.02 15.18h-.01a8.1 8.1 0 0 1-4.12-1.12l-.3-.18-3.23.84.86-3.15-.2-.32a8.14 8.14 0 0 1-1.25-4.33c0-4.49 3.67-8.15 8.17-8.15 2.18 0 4.22.84 5.76 2.39a8.08 8.08 0 0 1 2.38 5.77c0 4.49-3.67 8.15-8.16 8.15Zm4.47-6.11c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.95-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.31-.22.24-.84.82-.84 2 0 1.18.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
        </svg>
        <span>{t.whatsappCta}</span>
      </a>
    </div>

    <div
      data-hero-tech
      class="relative w-full max-w-full overflow-hidden rounded-[1.25rem] border border-[var(--text-main)]/10 bg-white/55 px-5 py-5 shadow-[0_18px_50px_rgba(42,52,98,.1)] backdrop-blur-sm sm:max-w-[36rem] sm:px-6"
    >
      <div class="relative z-10 mb-4 space-y-2" data-tech-text-block>
        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.24em] text-[var(--brand)]">
            {locale === "es" ? "Software de principio a fin" : "End-to-end software"}
          </p>
          <p data-tech-text-line class="max-w-2xl text-sm leading-7 text-[var(--text-main)] sm:text-[0.95rem]">
            {locale === "es" ? "Construyo productos desde la interfaz hasta los servicios que la sostienen: frontend, backend, APIs y bases de datos." : "I build products from the interface to the services behind it: frontend, backend, APIs, and databases."}
          </p>
          <p data-tech-text-line class="max-w-2xl text-sm leading-7 text-[var(--text-muted)] sm:text-[0.92rem]">
            {locale === "es" ? "Frontend, backend, APIs, microservicios y datos: React, Astro, Laravel, FastAPI, .NET Core, PostgreSQL y Docker." : "Frontend, backend, APIs, microservices, and data: React, Astro, Laravel, FastAPI, .NET Core, PostgreSQL, and Docker."}
          </p>
          <div class="flex flex-wrap gap-x-4 gap-y-1 pt-1 text-xs font-medium text-[var(--brand-strong)]" aria-label={locale === "es" ? "Tecnologías principales" : "Main technologies"}>
            <span>React · Astro</span><span>Laravel · FastAPI · .NET Core</span><span>PostgreSQL · Docker</span>
          </div>
        </div>
      </div>

      <div
        class="relative max-w-[33rem] overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [mask-repeat:no-repeat] [mask-size:100%_100%] [-webkit-mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [-webkit-mask-repeat:no-repeat] [-webkit-mask-size:100%_100%]"
        data-tech-marquee
      >
        <div
          data-tech-marquee-track
          class="flex w-max items-center py-2"
        >
          <div data-tech-marquee-group class="flex items-center gap-4 sm:gap-5">
            {stackIcons.map((item) => (
              <div
                data-tech-icon-slot
                class="flex h-12 shrink-0 items-center gap-2.5 px-2 sm:h-14"
              >
                <img
                  data-tech-icon
                  src={item.icon}
                  alt={item.name}
                  title={item.name}
                  loading="lazy"
                  class="h-7 w-7 shrink-0 object-contain opacity-82 transition duration-300 hover:opacity-100 sm:h-8 sm:w-8"
                />
                <span class="whitespace-nowrap text-xs font-medium text-[var(--text-main)]">{item.name}</span>
              </div>
            ))}
          </div>

          <div data-tech-marquee-group aria-hidden="true" class="flex items-center gap-4 sm:gap-5">
            {stackIcons.map((item) => (
              <div data-tech-icon-slot class="flex h-12 shrink-0 items-center gap-2.5 px-2 sm:h-14 sm:w-auto">
                <img
                  data-tech-icon
                  src={item.icon}
                  alt=""
                  loading="lazy"
                  class="h-7 w-7 shrink-0 object-contain opacity-82 sm:h-8 sm:w-8"
                />
                <span class="whitespace-nowrap text-xs font-medium text-[var(--text-main)]">{item.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    data-hero-media
    class="relative mx-auto mt-1 w-full max-w-full justify-self-center [perspective:1000px] sm:max-w-[23rem] xl:mt-0 xl:max-w-[29rem] xl:justify-self-end 2xl:max-w-[31rem]"
  >
    <div
      data-hero-media-card
      style="--spotlight-x:50%; --spotlight-y:50%;"
      class="relative flex min-h-[31rem] max-w-full overflow-hidden rounded-[1.5rem] border border-white/65 bg-white/45 p-3 shadow-[0_30px_80px_rgba(42,52,98,.18)] backdrop-blur-md sm:min-h-[35rem] xl:min-h-[42rem]"
    >
      <div
        data-hero-spotlight
        class="pointer-events-none absolute inset-0 opacity-0"
        style="background: radial-gradient(220px circle at var(--spotlight-x) var(--spotlight-y), rgba(255,255,255,0.3), rgba(175,172,255,0.16) 26%, transparent 62%);"
      ></div>
      <img
        src={profileImage.src}
        width={profileImage.width}
        height={profileImage.height}
        alt={t.profilePhotoAlt}
        class="h-full min-h-[27rem] w-full max-w-full flex-1 rounded-[1.1rem] object-cover object-center sm:min-h-[31rem] xl:min-h-[39rem]"
        loading="eager"
      />
      <div class="absolute inset-x-3 bottom-3 z-10 rounded-[.9rem] border border-white/20 bg-[#16202f]/78 p-3 backdrop-blur-xl">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-white">@giancarloarias96</p>
            <div class="mt-1 inline-flex items-center gap-2 text-xs text-white/70">
              <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
              <span>{t.onlineStatus}</span>
            </div>
          </div>
          <a
            href="https://wa.me/50660058595"
            target="_blank"
            rel="noreferrer"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-[var(--surface-page)] px-3 py-2 text-xs font-medium text-[var(--text-main)] transition-transform duration-300 hover:-translate-y-1"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.73.45 3.42 1.3 4.9L2 22l5.44-1.42a9.82 9.82 0 0 0 4.58 1.16h.01c5.41 0 9.82-4.4 9.82-9.82A9.75 9.75 0 0 0 19.05 4.91Zm-7.02 15.18h-.01a8.1 8.1 0 0 1-4.12-1.12l-.3-.18-3.23.84.86-3.15-.2-.32a8.14 8.14 0 0 1-1.25-4.33c0-4.49 3.67-8.15 8.17-8.15 2.18 0 4.22.84 5.76 2.39a8.08 8.08 0 0 1 2.38 5.77c0 4.49-3.67 8.15-8.16 8.15Zm4.47-6.11c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.95-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.31-.22.24-.84.82-.84 2 0 1.18.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
            </svg>
            <span>{t.contactMe}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden">
    <div class="absolute inset-0 rounded-[2rem] bg-gradient-to-br from-cyan-500/20 via-transparent to-violet-500/20 blur-2xl"></div>

    <div class="relative rounded-[2rem] border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
      
      <div class="space-y-5">

        <div class="flex items-center justify-between">
          <span class="text-sm text-white/50">Current Role</span>
          <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">
            Active
          </span>
        </div>

        <div>
          <h2 class="text-2xl font-semibold">
            Web Developer - Design Soft
          </h2>

          <p class="mt-2 text-white/65">
            Working on commercial websites, UI/UX improvements, SEO strategies and modern digital solutions.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <p class="text-sm text-white/45">Project</p>
            <p class="mt-1 text-lg font-medium">Taller Alpha</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <p class="text-sm text-white/45">Project</p>
            <p class="mt-1 text-lg font-medium">POSMovi</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <p class="text-sm text-white/45">Project</p>
            <p class="mt-1 text-lg font-medium">POS Restaurantes</p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <p class="text-sm text-white/45">Project</p>
            <p class="mt-1 text-lg font-medium">Taller de Motos</p>
          </div>

        </div>

      </div>
    </div>
  </div>

</section>

<script>
  import "../../utils/hero-animation";
  import "../../utils/hero-tech-marquee";

  const initTechWordHover = () => {
    document.querySelectorAll("[data-tech-text-line]").forEach((line) => {
      if (!(line instanceof HTMLElement) || line.dataset.splitReady === "true") return;

      const text = line.textContent?.trim();
      if (!text) return;

      line.dataset.splitReady = "true";
      line.setAttribute("aria-label", text);
      line.textContent = "";

      text.split(/\s+/).forEach((word, wordIndex, words) => {
        const wordSpan = document.createElement("span");
        wordSpan.dataset.techWord = "true";
        wordSpan.tabIndex = 0;
        wordSpan.style.display = "inline-flex";
        wordSpan.style.whiteSpace = "nowrap";
        wordSpan.style.verticalAlign = "baseline";
        wordSpan.style.cursor = "default";

        if (wordIndex < words.length - 1) {
          wordSpan.style.marginRight = "0.34em";
        }

        Array.from(word).forEach((letter, letterIndex) => {
          const letterSpan = document.createElement("span");
          letterSpan.dataset.techChar = "true";
          letterSpan.style.setProperty("--char-index", `${letterIndex}`);
          letterSpan.style.display = "inline-block";
          letterSpan.style.transform = "translate3d(0,0,0)";
          letterSpan.textContent = letter;
          wordSpan.appendChild(letterSpan);
        });

        let resetTimer = 0;
        const totalDuration = 1320 + Math.max(0, word.length - 1) * 48;

        const play = () => {
          window.clearTimeout(resetTimer);
          wordSpan.classList.remove("is-vaporizing");
          void wordSpan.offsetWidth;
          wordSpan.classList.add("is-vaporizing");
          resetTimer = window.setTimeout(() => {
            wordSpan.classList.remove("is-vaporizing");
          }, totalDuration);
        };

        wordSpan.addEventListener("pointerenter", play);
        wordSpan.addEventListener("focusin", play);
        line.appendChild(wordSpan);
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTechWordHover, { once: true });
  } else {
    initTechWordHover();
  }

  document.addEventListener("astro:page-load", initTechWordHover);
</script>

<style>
  .hero-surface { position: relative; overflow: hidden; background: radial-gradient(58% 68% at 95% 2%, rgb(207 229 251 / .78), transparent 68%), radial-gradient(46% 56% at 18% 66%, rgb(210 208 255 / .5), transparent 70%), linear-gradient(145deg, #f6f8fb 0%, #f4f5fa 45%, #faf8f3 100%); }
  .hero-surface::before { content: ""; pointer-events: none; position: absolute; inset: 0; opacity: .12; background-image: linear-gradient(rgb(22 32 47 / .1) 1px, transparent 1px), linear-gradient(90deg, rgb(22 32 47 / .1) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, black, transparent 58%); }
  [data-tech-word].is-vaporizing [data-tech-char] {
    animation: tech-word-vapor 1.32s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--char-index) * 48ms);
  }

  @keyframes tech-word-vapor {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
      filter: blur(0);
    }

    30% {
      transform: translate3d(0, -8px, 0) scale(1.02);
      opacity: 0;
      filter: blur(6px);
    }

    31% {
      transform: translate3d(0, 14px, 0) scale(0.97);
      opacity: 0;
      filter: blur(10px);
    }

    100% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-tech-word].is-vaporizing [data-tech-char] {
      animation: none;
    }
  }
</style>
</div>
