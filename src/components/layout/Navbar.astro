---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getMessages } from "../../i18n";
import type { Locale, PageId } from "../../i18n/types";

interface Props {
  currentPath?: string;
  locale?: Locale;
  page: PageId;
}

const { currentPath = "/", locale = "es", page } = Astro.props as Props;
const t = getMessages(locale);

const homeUrl = getRelativeLocaleUrl(locale);
const contactRoute = locale === "es" ? "contacto" : "contact";
const contactUrl = getRelativeLocaleUrl(locale, contactRoute);
const isActive = (href: string) => {
  if (href === homeUrl) return currentPath === homeUrl;
  return currentPath.startsWith(href);
};

const links = [
  { id: "home", href: homeUrl, label: t.navigation.home },
  { id: "about", href: `${homeUrl}#about`, label: t.navigation.about, active: page === "home" },
  { id: "contact", href: contactUrl, label: t.navigation.contact },
];
---

<header data-site-nav data-open-menu-label={t.navigation.openMenu} data-close-menu-label={t.navigation.closeMenu} class="fixed inset-x-0 top-0 z-40 pt-[env(safe-area-inset-top)]">
  <nav class="site-nav-bar relative z-10 h-12 w-full">
    <div class="relative mx-auto flex h-full w-full max-w-[64rem] items-center px-5 xl:px-0">

    <div class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 xl:flex">
      <span class="inline-flex h-8 w-8 items-center justify-center text-[#1d1d1f]/80" aria-hidden="true">
        <svg class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
      <a href={homeUrl} class:list={["py-1 text-sm transition-colors", isActive(homeUrl) ? "text-[#1d1d1f]" : "text-[#6e6e73] hover:text-[#1d1d1f]"]}>{t.navigation.home}</a>
      <a href={`${homeUrl}#about`} class:list={["py-1 text-sm transition-colors", page === "home" ? "text-[#1d1d1f]" : "text-[#6e6e73] hover:text-[#1d1d1f]"]}>{t.navigation.about}</a>
      <a href={contactUrl} class:list={["py-1 text-sm transition-colors", isActive(contactUrl) ? "text-[#1d1d1f]" : "text-[#6e6e73] hover:text-[#1d1d1f]"]}>{t.navigation.contact}</a>
      <a
        href="https://wa.me/50660058595"
        target="_blank"
        rel="noreferrer"
        class="group inline-flex min-h-10 items-center gap-2 px-2 py-2 text-sm font-semibold text-[#128C7E] transition-[transform,color] duration-200 hover:-translate-y-0.5 hover:text-[#0d7569] active:scale-[.97]"
      >
      <svg class="h-[1.05rem] w-[1.05rem] shrink-0 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.73.45 3.42 1.3 4.9L2 22l5.44-1.42a9.82 9.82 0 0 0 4.58 1.16h.01c5.41 0 9.82-4.4 9.82-9.82A9.75 9.75 0 0 0 19.05 4.91Zm-7.02 15.18h-.01a8.1 8.1 0 0 1-4.12-1.12l-.3-.18-3.23.84.86-3.15-.2-.32a8.14 8.14 0 0 1-1.25-4.33c0-4.49 3.67-8.15 8.17-8.15 2.18 0 4.22.84 5.76 2.39a8.08 8.08 0 0 1 2.38 5.77c0 4.49-3.67 8.15-8.16 8.15Zm4.47-6.11c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.95-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.31-.22.24-.84.82-.84 2 0 1.18.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
      </svg>
      {t.navigation.whatsapp}
      </a>
    </div>

    <div class="flex w-full items-center xl:hidden">
      <a href={homeUrl} aria-label={t.navigation.home} class="mobile-home inline-flex h-11 w-11 items-center justify-center text-[#1d1d1f]/80 transition-colors hover:text-[#1d1d1f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1d1d1f]">
        <svg class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
      <button data-nav-toggle type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label={t.navigation.openMenu} class="menu-toggle ml-auto inline-flex min-h-11 min-w-11 items-center justify-center text-[#1d1d1f] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1d1d1f]">
        <span class="sr-only">{t.navigation.openMenu}</span>
        <span class="menu-toggle-line menu-toggle-line-top" aria-hidden="true"></span>
        <span class="menu-toggle-line menu-toggle-line-bottom" aria-hidden="true"></span>
      </button>
    </div>
    </div>
  </nav>

  <div id="mobile-navigation" data-nav-panel hidden aria-hidden="true" class="site-nav-panel fixed inset-0 z-0 overflow-y-auto text-[#1d1d1f] xl:hidden">
    <div class="mx-auto flex min-h-dvh w-full max-w-[64rem] flex-col px-5 pb-7 pt-[calc(env(safe-area-inset-top)+3rem)] xl:px-0">
      <nav aria-label={t.navigation.openMenu} class="mt-7 grid sm:mt-8">
        {links.map((link) => {
          const active = "active" in link ? link.active : isActive(link.href);

          return (
            <a data-nav-link href={link.href} class:list={["group flex min-h-16 items-center gap-3 border-b border-black/8 text-[clamp(1.85rem,7vw,3.25rem)] font-semibold leading-none tracking-[-.055em] transition-colors", active ? "text-[#1d1d1f]" : "text-[#6e6e73] hover:text-[#1d1d1f]"]}>
              {link.id === "about" && (
                <svg class="h-7 w-7 shrink-0 stroke-current stroke-[1.7] opacity-75 transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="8" r="3.25" />
                  <path d="M5 20c.75-3.45 3.15-5.25 7-5.25S18.25 16.55 19 20" stroke-linecap="round" />
                </svg>
              )}
              {link.id === "contact" && (
                <svg class="h-7 w-7 shrink-0 stroke-current stroke-[1.7] opacity-75 transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="3.75" y="5.75" width="16.5" height="12.5" rx="2" />
                  <path d="m4.5 7 6.03 4.34a2.5 2.5 0 0 0 2.94 0L19.5 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              <span>{link.label}</span>
            </a>
          );
        })}
      </nav>

      <a data-nav-link href="https://wa.me/50660058595" target="_blank" rel="noreferrer" class="group flex min-h-16 items-center gap-3 border-b border-black/8 text-[clamp(1.85rem,7vw,3.25rem)] font-semibold leading-none tracking-[-.055em] text-[#128C7E] transition-colors hover:text-[#0d7569]">
        <svg class="h-7 w-7 shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.03 2C6.62 2 2.2 6.4 2.2 11.82c0 1.73.45 3.42 1.3 4.9L2 22l5.44-1.42a9.82 9.82 0 0 0 4.58 1.16h.01c5.41 0 9.82-4.4 9.82-9.82A9.75 9.75 0 0 0 19.05 4.91Zm-7.02 15.18h-.01a8.1 8.1 0 0 1-4.12-1.12l-.3-.18-3.23.84.86-3.15-.2-.32a8.14 8.14 0 0 1-1.25-4.33c0-4.49 3.67-8.15 8.17-8.15 2.18 0 4.22.84 5.76 2.39a8.08 8.08 0 0 1 2.38 5.77c0 4.49-3.67 8.15-8.16 8.15Zm4.47-6.11c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.23-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.95-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.54-1.3-.74-1.78-.2-.48-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.31-.22.24-.84.82-.84 2 0 1.18.86 2.33.98 2.49.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" /></svg>
        {t.navigation.whatsapp}
      </a>
    </div>
  </div>
</header>

<script>
  const initNavigation = () => {
    const header = document.querySelector("[data-site-nav]");
    if (!header || header.dataset.navigationReady === "true") return;

    header.dataset.navigationReady = "true";
    const toggle = header.querySelector("[data-nav-toggle]");
    const panel = header.querySelector("[data-nav-panel]");
    const openMenuLabel = header.dataset.openMenuLabel || "Open menu";
    const closeMenuLabel = header.dataset.closeMenuLabel || "Close menu";

    if (!toggle || !panel) return;

    let closeTimer: number | undefined;

    const closeMenu = () => {
      panel.removeAttribute("data-open");
      header.removeAttribute("data-menu-open");
      panel.setAttribute("aria-hidden", "true");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", openMenuLabel);
      document.body.classList.remove("overflow-hidden");
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        if (toggle.getAttribute("aria-expanded") === "false") panel.hidden = true;
      }, 280);
    };

    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
        return;
      }
      window.clearTimeout(closeTimer);
      panel.hidden = false;
      panel.setAttribute("aria-hidden", "false");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", closeMenuLabel);
      header.setAttribute("data-menu-open", "true");
      document.body.classList.add("overflow-hidden");
      window.requestAnimationFrame(() => panel.setAttribute("data-open", "true"));
    });

    panel.querySelectorAll("[data-nav-link]").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  };

  initNavigation();
  document.addEventListener("astro:page-load", initNavigation);
</script>

<style>
  .site-nav-bar {
    background: rgb(255 255 255 / 78%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
    transition: background-color 220ms ease;
  }
  .site-nav-panel {
    background: #fff;
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }
  .site-nav-panel[data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  [data-site-nav][data-menu-open="true"] .site-nav-bar {
    background: #fff;
  }
  .menu-toggle {
    position: relative;
  }
  .menu-toggle-line {
    position: absolute;
    width: 1.25rem;
    height: 2px;
    border-radius: 99px;
    background: currentColor;
    top: 50%;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-toggle-line-top {
    transform: translateY(-4px);
  }
  .menu-toggle-line-bottom {
    transform: translateY(4px);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-line-top {
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle-line-bottom {
    transform: rotate(-45deg);
  }
  .mobile-home {
    transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-site-nav][data-menu-open="true"] .mobile-home {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-nav-bar {
      background: #fff;
    }
    .site-nav-panel {
      background: #fff;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-nav-panel,
    .menu-toggle-line {
      transition: none;
    }
  }
</style>
