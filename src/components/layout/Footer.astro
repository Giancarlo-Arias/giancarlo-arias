---
const year = new Date().getFullYear();
import { getMessages } from "../../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../../i18n/types";
interface Props { locale?: Locale }
const { locale = "es" } = Astro.props as Props;
const t = getMessages(locale);
const homeUrl = getRelativeLocaleUrl(locale);
const contactUrl = getRelativeLocaleUrl(locale, locale === "es" ? "contacto" : "contact");
---

<footer class="bg-[var(--surface-page)] px-6 pb-8 pt-6 text-[#465a56] lg:px-10">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 border-t border-[var(--text-main)]/20 px-1 py-7 text-sm md:flex-row md:items-center md:justify-between">
    <p>Copyright {year} {t.site.name}. {t.footer.copyright}</p>

    <div class="flex flex-wrap items-center gap-4">
      <a href={homeUrl} class="transition hover:text-[var(--text-main)]">{t.footer.home}</a>
      <a href={`${homeUrl}#about`} class="transition hover:text-[var(--text-main)]">{t.footer.about}</a>
      <a href={contactUrl} class="transition hover:text-[var(--text-main)]">{t.footer.contact}</a>
    </div>
  </div>
</footer>
